        0
      ]
    },
    {
      "name": "Pick due posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "let queue;\ntry { queue = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'data')).toString()); } catch (e) { throw new Error('queue.json is missing or not valid JSON'); }\nconst now = new Date();\nconst due = queue.filter(p => !p.sentAt && new Date(p.at) <= now);\nfor (const p of due) p.sentAt = now.toISOString();\n// Publishing to X needs an API key, so due posts go to outbox.jsonl for now.\nreturn [{ json: { due: due.length, waiting: queue.filter(p => !p.sentAt).length, queueText: JSON.stringify(queue, null, 2), text: due.map(p => JSON.stringify(p)).join('\\n') + (due.length ? '\\n' : '') } }];"
      },
      "id": "night07queue-s1",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Save queue (to file)",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "parameters": {
        "operation": "toText",
        "sourceProperty": "queueText",
        "options": {
          "fileName": "queue.json"
        }
      },
      "id": "night07queue-s2",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Save queue",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "parameters": {
        "operation": "write",
        "fileName": "C:/Users/artem/x/n8n-night/out/queue.json",
        "dataPropertyName": "data",
        "options": {
          "append": false
        }
      },
      "id": "night07queue-s3",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Outbox lines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { text: $('Pick due posts').first().json.text } }];"
      },
      "id": "night07queue-s4",
      "position": [
        1100,
        0
      ]
    },
    {
