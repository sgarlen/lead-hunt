        220,
        0
      ]
    },
    {
      "name": "Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "let prev = {};\ntry { prev = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'data')).toString()); } catch (e) {}\nconst pages = ['https://n8n.io/pricing/', 'https://docs.n8n.io/release-notes/', 'https://www.anthropic.com/pricing'];\nreturn pages.map(url => ({ json: { url, prevHash: prev[url] ?? null } }));"
      },
      "id": "night04pages-s1",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "night04pages-s2",
      "position": [
        660,
        0
      ]
    },
    {
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const pages = $('Pages').all();\nconst hash = s => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h.toString(16); };\nconst state = {};\nconst rows = $input.all().map((item, i) => {\n  const { url, prevHash } = pages[i].json;\n  const body = String(item.json.data ?? '').replace(/<script[\\s\\S]*?<\\/script>/g, '').replace(/<style[\\s\\S]*?<\\/style>/g, '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n  const ok = item.json.statusCode === 200;\n  const h = ok ? hash(body) : prevHash;\n  if (h) state[url] = h;\n  return { checkedAt: new Date().toISOString(), url, status: !ok ? 'fetch failed' : prevHash === null ? 'baseline saved' : prevHash === h ? 'no change' : 'CHANGED' };\n});\nreturn [{ json: { changed: rows.filter(r => r.status === 'CHANGED').length, stateText: JSON.stringify(state, null, 2), text: rows.map(r => JSON.stringify(r)).join('\\n') + '\\n' } }];"
      },
      "id": "night04pages-s3",
      "position": [
        880,
        0
      ]
    },
    {
      "name": "Save hashes (to file)",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "parameters": {
        "operation": "toText",
        "sourceProperty": "stateText",
        "options": {
          "fileName": "state-pages.json"
        }
      },
      "id": "night04pages-s4",
