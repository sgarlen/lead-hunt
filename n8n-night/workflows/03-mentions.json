    {
      "name": "Search Hacker News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "=https://hn.algolia.com/api/v1/search_by_date?tags=story&hitsPerPage=8&query={{ encodeURIComponent($json.q) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "night03mentions-s1",
      "position": [
        440,
        0
      ]
    },
    {
      "name": "Build mention list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const keywords = $('Keywords').all();\nlet total = 0;\nconst blocks = $input.all().map((item, i) => {\n  const hits = item.json.body?.hits ?? [];\n  total += hits.length;\n  const lines = hits.map(h => '- ' + h.created_at.slice(0, 16).replace('T', ' ') + ' | ' + h.points + ' pts | [' + h.title + '](https://news.ycombinator.com/item?id=' + h.objectID + ')');\n  return '## ' + keywords[i].json.q + '\\n\\n' + lines.join('\\n');\n});\nreturn [{ json: { total, text: '# Mentions ' + new Date().toISOString() + '\\n\\n' + blocks.join('\\n\\n') + '\\n' } }];"
      },
      "id": "night03mentions-s2",
      "position": [
        660,
        0
      ]
    },
