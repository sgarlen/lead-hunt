            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append lead (to file)": {
      "main": [
        [
          {
            "node": "Append lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
