# Copy this file to .env. Everything here is optional.

# Adds ratings, review counts and review quotes from Google Places.
# Create a key in Google Cloud with "Places API (New)" enabled. Requests are billed by Google.
GOOGLE_PLACES_API_KEY=

# Upper limit of Google requests per search (one request per candidate lead).
GOOGLE_MAX_CALLS=40

# Port for the local server.
PORT=8765
